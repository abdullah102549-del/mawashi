<script>
// ── Direct REST API (no external library) ──
let _apiBase='', _apiKey='';
function initDB(url,key){_apiBase=url+'/rest/v1';_apiKey=key;}
function _url(t,qs){return _apiBase+'/'+t+'?apikey='+_apiKey+(qs?'&'+qs:'');}
const _fetchOpts={mode:'cors',credentials:'omit'};
async function dbSel(table,qs=''){
  const r=await fetch(_url(table,qs),{..._fetchOpts});
  if(!r.ok){const e=await r.text();throw new Error(e);}
  return r.json();
}
async function dbIns(table,data){
  const r=await fetch(_url(table,'select=*'),{..._fetchOpts,method:'POST',headers:{'Content-Type':'application/json','Prefer':'return=representation'},body:JSON.stringify(data)});
  if(!r.ok){const e=await r.text();throw new Error(e);}
  return r.json();
}
async function dbUpd(table,data,id){
  const r=await fetch(_url(table,'id=eq.'+id),{..._fetchOpts,method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});
  if(!r.ok){const e=await r.text();throw new Error(e);}
}
async function dbDel(table,id){
  const r=await fetch(_url(table,'id=eq.'+id),{..._fetchOpts,method:'DELETE'});
  if(!r.ok){const e=await r.text();throw new Error(e);}
}
</script>
<script>
const DAY=['الأحد','الاثنين','الثلاثاء','الأربعاء','الخميس','الجمعة','السبت'];
const MON=['يناير','فبراير','مارس','أبريل','مايو','يونيو','يوليو','أغسطس','سبتمبر','أكتوبر','نوفمبر','ديسمبر'];
const SQL=`CREATE TABLE IF NOT EXISTS buyers (id UUID DEFAULT gen_random_uuid() PRIMARY KEY, name TEXT NOT NULL, phone TEXT DEFAULT '', created_at TIMESTAMPTZ DEFAULT NOW());
CREATE TABLE IF NOT EXISTS categories (id UUID DEFAULT gen_random_uuid() PRIMARY KEY, name TEXT NOT NULL, default_price DECIMAL(10,2) DEFAULT 0, created_at TIMESTAMPTZ DEFAULT NOW());
CREATE TABLE IF NOT EXISTS sales (id UUID DEFAULT gen_random_uuid() PRIMARY KEY, sale_date DATE NOT NULL, buyer_id UUID REFERENCES buyers(id) ON DELETE SET NULL, category_id UUID REFERENCES categories(id) ON DELETE SET NULL, quantity INTEGER NOT NULL DEFAULT 1, unit_price DECIMAL(10,2) NOT NULL DEFAULT 0, notes TEXT DEFAULT '', created_at TIMESTAMPTZ DEFAULT NOW());
ALTER TABLE buyers ENABLE ROW LEVEL SECURITY;
ALTER TABLE categories ENABLE ROW LEVEL SECURITY;
ALTER TABLE sales ENABLE ROW LEVEL SECURITY;
DROP POLICY IF EXISTS "open" ON buyers;
DROP POLICY IF EXISTS "open" ON categories;
DROP POLICY IF EXISTS "open" ON sales;
CREATE POLICY "open" ON buyers FOR ALL USING (true) WITH CHECK (true);
CREATE POLICY "open" ON categories FOR ALL USING (true) WITH CHECK (true);
CREATE POLICY "open" ON sales FOR ALL USING (true) WITH CHECK (true);`;

let db=true,buyers=[],cats=[],editId=null;
function boot(url,key){
  try{
    initDB(url,key);
    fc('setup-screen').style.display='none';
    fc('app').style.display='block';
    setDateUI();populateMonths();
    loadBuyers().then(()=>loadCats()).then(()=>{loadDash();updateDP();}).catch(e=>alert('خطأ في الاتصال:\n'+e.name+': '+e.message+'\n\nتأكد من اتصال الإنترنت'));
    document.addEventListener('click',e=>{const ms=fc('more-sheet');if(ms&&ms.style.display!=='none'&&!ms.contains(e.target)&&!e.target.closest('#more-btn'))ms.style.display='none';const cp=fc('cal-popup');if(cp&&cp.style.display!=='none'&&!cp.contains(e.target)&&!e.target.closest('[onclick*="toggleCal"]'))cp.style.display='none';});
  }catch(e){msg('setup-msg','er','❌ '+e.message);}
}

const fc=id=>document.getElementById(id);
const fmtC=n=>Number(n||0).toLocaleString('ar-SA')+' ريال';
const fmtD=d=>{if(!d)return'—';const p=d.split('-');return parseInt(p[2])+' '+MON[parseInt(p[1])-1]+' '+p[0];};
const today=()=>new Date().toISOString().split('T')[0];
const nowMY=()=>{const d=new Date();return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0');};

function monthOpts(){const o=[];const d=new Date();for(let i=-6;i<24;i++){const dt=new Date(d.getFullYear(),d.getMonth()-i,1);o.push({v:dt.getFullYear()+'-'+String(dt.getMonth()+1).padStart(2,'0'),l:MON[dt.getMonth()]+' '+dt.getFullYear()});}return o;}
function setDateUI(){const d=new Date();if(fc('sb-day'))fc('sb-day').textContent=DAY[d.getDay()];if(fc('sb-date'))fc('sb-date').textContent=d.getDate()+' '+MON[d.getMonth()]+' '+d.getFullYear();if(fc('mob-date'))fc('mob-date').textContent=DAY[d.getDay()]+' '+d.getDate()+' '+MON[d.getMonth()];}
function msg(id,t,txt){const e=fc(id);if(!e)return;e.innerHTML=`<div class="alert ${t==='ok'?'a-ok':'a-er'}">${txt}</div>`;setTimeout(()=>e.innerHTML='',4000);}

// SETUP
fc('sql-code').textContent=SQL;
function toggleSQL(){const b=fc('sql-box');b.style.display=b.style.display==='none'?'block':'none';}
function copySQL(){navigator.clipboard.writeText(SQL).then(()=>alert('✅ تم النسخ — الصقه في SQL Editor ثم اضغط RUN'));}
function doConnect(){
  const url=fc('inp-url').value.trim(),key=fc('inp-key').value.trim();
  if(!url||!key){msg('setup-msg','er','⚠️ أدخل الرابط والمفتاح');return;}
  localStorage.setItem('mt_u',url);localStorage.setItem('mt_k',key);boot(url,key);
}
function resetSetup(){
  if(confirm('إعادة الإعداد؟')){
    localStorage.removeItem('mt_u');localStorage.removeItem('mt_k');
    window.location.href=window.location.origin+window.location.pathname+'?t='+Date.now();
  }
}
window.addEventListener('load',()=>{const u=localStorage.getItem('mt_u'),k=localStorage.getItem('mt_k');if(u&&k)boot(u,k);else fc('setup-screen').style.display='block';});

// NAV
function go(p){
  document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));
  document.querySelectorAll('[data-p]').forEach(x=>x.classList.remove('active'));
  fc('pg-'+p).classList.add('active');
  document.querySelectorAll(`[data-p="${p}"]`).forEach(x=>x.classList.add('active'));
  fc('more-sheet').style.display='none';
  if(p==='dash')loadDash();
  if(p==='list')loadList();
  if(p==='cats'){loadCats().then(renderCats);}
  if(p==='buyers'){loadBuyers().then(renderBuyers);}
  if(p==='reports')loadReports();
  if(p==='entry'&&!editId)clearForm();
  window.scrollTo(0,0);
}
function toggleMore(){const s=fc('more-sheet');s.style.display=s.style.display==='none'?'block':'none';}

// DATA
async function loadBuyers(){const data=await dbSel('buyers','order=name');buyers=data||[];refreshSelects();return buyers;}
async function loadCats(){const data=await dbSel('categories','order=name');cats=data||[];refreshCatSel();return cats;}
function refreshSelects(){
  ['f-buyer','l-buyer','r-buyer'].forEach(id=>{
    const e=fc(id);if(!e)return;const c=e.value;
    e.innerHTML=(id==='f-buyer'?'<option value="">— اختر —</option>':'<option value="">الكل</option>')+buyers.map(b=>`<option value="${b.id}">${b.name}</option>`).join('');
    e.value=c;
  });
}
function refreshCatSel(){
  const e=fc('f-cat');if(!e)return;const c=e.value;
  e.innerHTML='<option value="">— اختر الصنف —</option>'+cats.map(x=>`<option value="${x.id}" data-pr="${x.default_price||0}">${x.name}${x.default_price>0?' ('+x.default_price+' ريال)':''}</option>`).join('');
  e.value=c;
}
function populateMonths(){
  const o=monthOpts();const cur=nowMY();
  ['l-month','r-month'].forEach(id=>{
    const e=fc(id);if(!e)return;
    const ph=id==='l-month'?'<option value="">كل الأشهر</option>':'';
    e.innerHTML=ph+o.map(x=>`<option value="${x.v}"${x.v===cur?' selected':''}>${x.l}</option>`).join('');
  });
}

// DASHBOARD
async function loadDash(){
  try{
    const td=today(),my=nowMY();const[y,m]=my.split('-');const last=new Date(y,m,0).getDate();
    const[dy,mn,rc]=await Promise.all([
      dbSel('sales','sale_date=eq.'+td+'&select=quantity,unit_price'),
      dbSel('sales','sale_date=gte.'+my+'-01&sale_date=lte.'+my+'-'+last+'&select=quantity,unit_price'),
      dbSel('sales','order=created_at.desc&limit=5&select=*,buyers(name),categories(name)')
    ]);
    const tr=(dy||[]).reduce((s,x)=>s+x.quantity*x.unit_price,0);
    const mr=(mn||[]).reduce((s,x)=>s+x.quantity*x.unit_price,0);
    fc('d-stats').innerHTML=`
      <div class="sc g"><div class="sl">مبيعات اليوم</div><div class="sv">${(dy||[]).length}</div><div class="ss">صفقة</div></div>
      <div class="sc gr"><div class="sl">إيرادات اليوم</div><div class="sv sm">${fmtC(tr)}</div></div>
      <div class="sc br"><div class="sl">مبيعات الشهر</div><div class="sv">${(mn||[]).length}</div><div class="ss">صفقة</div></div>
      <div class="sc bl"><div class="sl">إيرادات الشهر</div><div class="sv sm">${fmtC(mr)}</div></div>
      <div class="sc g"><div class="sl">المشترون</div><div class="sv">${buyers.length}</div></div>
      <div class="sc br"><div class="sl">الأصناف</div><div class="sv">${cats.length}</div></div>`;
    if(rc&&rc.length>0){
      fc('d-recent').style.display='block';
      fc('d-tbody').innerHTML=rc.map(s=>`<tr><td style="white-space:nowrap">${fmtD(s.sale_date)}</td><td style="font-weight:700">${s.buyers?.name||'—'}</td><td><span class="badge ba">${s.categories?.name||'—'}</span></td><td>${s.quantity} رأس</td><td style="font-weight:800;color:#7DEBB0">${fmtC(s.quantity*s.unit_price)}</td></tr>`).join('');
    }
  }catch(e){console.error(e);}
}

// ENTRY
let selDate=new Date();let calViewYear=selDate.getFullYear();let calViewMonth=selDate.getMonth();
function updateDP(){
  fc('dp-dayname').textContent=DAY[selDate.getDay()];
  fc('dp-full').textContent=selDate.getDate()+' '+MON[selDate.getMonth()]+' '+selDate.getFullYear();
  const iso=selDate.getFullYear()+'-'+String(selDate.getMonth()+1).padStart(2,'0')+'-'+String(selDate.getDate()).padStart(2,'0');
  fc('f-date').value=iso;
}
function changeDay(d){selDate=new Date(selDate.getFullYear(),selDate.getMonth(),selDate.getDate()+d);updateDP();}
function toggleCal(e){if(e)e.stopPropagation();const p=fc('cal-popup');if(p.style.display==='none'){calViewYear=selDate.getFullYear();calViewMonth=selDate.getMonth();renderCal();p.style.display='block';}else p.style.display='none';}
function closeCal(){fc('cal-popup').style.display='none';}
function goToday(){selDate=new Date();updateDP();calViewYear=selDate.getFullYear();calViewMonth=selDate.getMonth();renderCal();}
function calNav(d){calViewMonth+=d;if(calViewMonth>11){calViewMonth=0;calViewYear++;}else if(calViewMonth<0){calViewMonth=11;calViewYear--;}renderCal();}
function renderCal(){
  fc('cal-header').textContent=MON[calViewMonth]+' '+calViewYear;
  const grid=fc('cal-grid');grid.innerHTML='';
  const first=new Date(calViewYear,calViewMonth,1).getDay();
  const days=new Date(calViewYear,calViewMonth+1,0).getDate();
  const td=new Date();
  for(let i=0;i<first;i++){const e=document.createElement('div');grid.appendChild(e);}
  for(let d=1;d<=days;d++){
    const btn=document.createElement('button');
    btn.type='button';btn.textContent=d;
    const isToday=d===td.getDate()&&calViewMonth===td.getMonth()&&calViewYear===td.getFullYear();
    const isSel=d===selDate.getDate()&&calViewMonth===selDate.getMonth()&&calViewYear===selDate.getFullYear();
    btn.style.cssText=`width:100%;aspect-ratio:1;border-radius:8px;border:none;font-family:'Tajawal',sans-serif;font-size:13px;font-weight:700;cursor:pointer;transition:all .1s;`+
      (isSel?'background:var(--gold);color:#0F0F13;':isToday?'background:var(--bg4);color:var(--gold);border:1px solid var(--gold);':'background:transparent;color:var(--text);');
    btn.onmouseover=()=>{if(!isSel)btn.style.background='var(--bg4)';};
    btn.onmouseout=()=>{if(!isSel&&!isToday)btn.style.background='transparent';};
    btn.onclick=()=>{selDate=new Date(calViewYear,calViewMonth,d);updateDP();closeCal();};
    grid.appendChild(btn);
  }
}
function onDatePick(){}
function showDayName(){}
function clearForm(){
  editId=null;
  selDate=new Date();updateDP();fc('f-buyer').value='';fc('f-cat').value='';
  fc('f-qty').value=1;fc('f-price').value='';fc('f-notes').value='';
  fc('total-bar').style.display='none';
  fc('entry-title').textContent='➕ إدخال مبيعة';
  fc('btn-save').textContent='✅ حفظ المبيعة';
  fc('btn-cancel').style.display='none';fc('btn-clr').style.display='inline-flex';
}
function fillPrice(){
  if(editId)return;
  const s=fc('f-cat');const o=s.options[s.selectedIndex];
  if(o&&parseFloat(o.dataset.pr)>0)fc('f-price').value=o.dataset.pr;
  calcTotal();
}
function calcTotal(){
  const q=parseFloat(fc('f-qty').value)||0,p=parseFloat(fc('f-price').value)||0,t=q*p;
  if(t>0){fc('total-bar').style.display='flex';fc('t-det').textContent=q+' رأس × '+fmtC(p);fc('t-val').textContent=fmtC(t);}
  else fc('total-bar').style.display='none';
}
async function saveSale(){
  const date=fc('f-date').value,buyer=fc('f-buyer').value,cat=fc('f-cat').value;
  const qty=parseInt(fc('f-qty').value)||0,price=parseFloat(fc('f-price').value)||0,notes=fc('f-notes').value.trim();
  if(!date||!buyer||!cat||qty<1||price<=0){msg('entry-msg','er','⚠️ أكمل جميع الحقول المطلوبة');return;}
  const btn=fc('btn-save');btn.disabled=true;btn.textContent='⏳ جارٍ الحفظ...';
  try{
    const pl={sale_date:date,buyer_id:buyer,category_id:cat,quantity:qty,unit_price:price,notes};
    if(editId){await dbUpd('sales',pl,editId);msg('entry-msg','ok','✅ تم تعديل البيانات');}
    else{await dbIns('sales',pl);msg('entry-msg','ok','✅ تم حفظ المبيعة ✓');clearForm();}
    editId=null;fc('btn-cancel').style.display='none';fc('btn-clr').style.display='inline-flex';
  }catch(e){msg('entry-msg','er','❌ '+e.message);}
  btn.disabled=false;btn.textContent=editId?'💾 حفظ التعديل':'✅ حفظ المبيعة';
}
function startEdit(s){
  editId=s.id;const dp=s.sale_date.split('-');selDate=new Date(parseInt(dp[0]),parseInt(dp[1])-1,parseInt(dp[2]));updateDP();fc('f-buyer').value=s.buyer_id||'';fc('f-cat').value=s.category_id||'';
  fc('f-qty').value=s.quantity;fc('f-price').value=s.unit_price;fc('f-notes').value=s.notes||'';
  fc('entry-title').textContent='✏️ تعديل مبيعة';fc('btn-save').textContent='💾 حفظ التعديل';
  fc('btn-cancel').style.display='inline-flex';fc('btn-clr').style.display='none';
  calcTotal();go('entry');
}
function cancelEdit(){clearForm();go('list');}

// LIST
async function loadList(){
  const month=fc('l-month').value,buyer=fc('l-buyer').value;
  const wrap=fc('list-wrap');wrap.innerHTML='<div class="empty"><p>⏳ جارٍ التحميل...</p></div>';
  try{
    let qs='select=*,buyers(name),categories(name)&order=sale_date.desc,created_at.desc';
    if(month){const[y,m]=month.split('-');const last=new Date(y,m,0).getDate();qs+='&sale_date=gte.'+month+'-01&sale_date=lte.'+month+'-'+last;}
    if(buyer)qs+='&buyer_id=eq.'+buyer;
    const sales=await dbSel('sales',qs);
    fc('list-sub').textContent=(sales||[]).length+' صفقة';
    const tr=(sales||[]).reduce((s,x)=>s+x.quantity*x.unit_price,0),th=(sales||[]).reduce((s,x)=>s+x.quantity,0);
    fc('list-stats').innerHTML=sales&&sales.length>0?`
      <div class="sc g"><div class="sl">الإيرادات</div><div class="sv sm">${fmtC(tr)}</div></div>
      <div class="sc gr"><div class="sl">الصفقات</div><div class="sv">${(sales||[]).length}</div></div>
      <div class="sc br"><div class="sl">الرؤوس</div><div class="sv">${th}</div></div>`:'';
    if(!sales||sales.length===0){wrap.innerHTML='<div class="empty"><span class="ei">📭</span><p>لا توجد مبيعات</p></div>';return;}
    wrap.innerHTML=`<table><thead><tr><th>التاريخ</th><th>المشتري</th><th>الصنف</th><th>العدد</th><th>سعر الرأس</th><th>الإجمالي</th><th>ملاحظات</th><th></th></tr></thead>
      <tbody>${sales.map(s=>`<tr>
        <td style="white-space:nowrap">${fmtD(s.sale_date)}</td>
        <td style="font-weight:700">${s.buyers?.name||'—'}</td>
        <td><span class="badge ba">${s.categories?.name||'—'}</span></td>
        <td>${s.quantity} رأس</td><td>${fmtC(s.unit_price)}</td>
        <td style="font-weight:800;color:#7DEBB0">${fmtC(s.quantity*s.unit_price)}</td>
        <td style="color:var(--text3);font-size:12px;">${s.notes||'—'}</td>
        <td><div style="display:flex;gap:4px;">
          <button class="btn b-outline b-sm" onclick='startEdit(${JSON.stringify(s).replace(/'/g,"&#39;")})'>✏️</button>
          <button class="btn b-red b-sm" onclick="delSale('${s.id}')">🗑️</button>
        </div></td></tr>`).join('')}</tbody></table>`;
  }catch(e){wrap.innerHTML='<div class="empty"><p>❌ خطأ</p></div>';}
}
async function delSale(id){if(!confirm('حذف هذه المبيعة؟'))return;await dbDel('sales',id);loadList();}

// CATS
function renderCats(){
  fc('cats-cnt').textContent=cats.length;
  const e=fc('cats-tbl');
  if(!cats.length){e.innerHTML='<div class="empty"><span class="ei">🐑</span><p>أضف أول صنف</p></div>';return;}
  e.innerHTML=`<table><thead><tr><th>#</th><th>الصنف</th><th>السعر</th><th></th></tr></thead>
    <tbody>${cats.map((c,i)=>`<tr><td style="color:var(--text3)">${i+1}</td><td style="font-weight:700">${c.name}</td>
      <td>${c.default_price>0?fmtC(c.default_price):'<span style="color:var(--text3)">—</span>'}</td>
      <td><div style="display:flex;gap:4px;"><button class="btn b-outline b-sm" onclick="editCat('${c.id}','${c.name.replace(/'/g,"\\'")}',${c.default_price||0})">✏️</button>
      <button class="btn b-red b-sm" onclick="delCat('${c.id}')">🗑️</button></div></td></tr>`).join('')}
    </tbody></table>`;
}
async function saveCat(){
  const name=fc('cat-name').value.trim(),price=parseFloat(fc('cat-price').value)||0,eid=fc('cat-eid').value;
  if(!name){msg('cats-msg','er','أدخل اسم الصنف');return;}
  try{
    if(eid){await dbUpd('categories',{name,default_price:price},eid);}
    else{await dbIns('categories',{name,default_price:price});}
    cancelCat();
    const d=await dbSel('categories','order=name');
    cats=d||[];
    refreshCatSel();
    renderCats();
    msg('cats-msg','ok',eid?'✅ تم تعديل الصنف':'✅ تمت الإضافة');
  }catch(e){
    const detail=e.name+': '+e.message;
    alert('خطأ:\n'+detail);
    msg('cats-msg','er','❌ '+detail);
  }
}
function editCat(id,name,price){fc('cat-eid').value=id;fc('cat-name').value=name;fc('cat-price').value=price||'';fc('cat-form-t').textContent='✏️ تعديل الصنف';fc('cat-cancel-btn').style.display='inline-flex';}
function cancelCat(){fc('cat-eid').value='';fc('cat-name').value='';fc('cat-price').value='';fc('cat-form-t').textContent='➕ إضافة صنف';fc('cat-cancel-btn').style.display='none';}
async function delCat(id){if(!confirm('حذف هذا الصنف؟'))return;await dbDel('categories',id);await loadCats();renderCats();}

// BUYERS
function renderBuyers(){
  fc('buyers-cnt').textContent=buyers.length;
  const e=fc('buyers-tbl');
  if(!buyers.length){e.innerHTML='<div class="empty"><span class="ei">👥</span><p>أضف أول مشترٍ</p></div>';return;}
  e.innerHTML=`<table><thead><tr><th>#</th><th>الاسم</th><th>الجوال</th><th></th></tr></thead>
    <tbody>${buyers.map((b,i)=>`<tr><td style="color:var(--text3)">${i+1}</td><td style="font-weight:700">${b.name}</td>
      <td style="direction:ltr;text-align:right;">${b.phone||'<span style="color:var(--text3)">—</span>'}</td>
      <td><div style="display:flex;gap:4px;"><button class="btn b-outline b-sm" onclick="editBuyer('${b.id}','${b.name.replace(/'/g,"\\'")}','${b.phone||''}')">✏️</button>
      <button class="btn b-red b-sm" onclick="delBuyer('${b.id}')">🗑️</button></div></td></tr>`).join('')}
    </tbody></table>`;
}
async function saveBuyer(){
  const name=fc('buyer-name').value.trim(),phone=fc('buyer-phone').value.trim(),eid=fc('buyer-eid').value;
  if(!name){msg('buyers-msg','er','أدخل الاسم');return;}
  try{
    if(eid){await dbUpd('buyers',{name,phone},eid);}
    else{await dbIns('buyers',{name,phone});}
    cancelBuyer();
    const d=await dbSel('buyers','order=name');
    buyers=d||[];
    refreshSelects();
    renderBuyers();
    msg('buyers-msg','ok',eid?'✅ تم التعديل':'✅ تمت الإضافة');
  }catch(e){
    const detail=e.name+': '+e.message;
    alert('خطأ:\n'+detail);
    msg('buyers-msg','er','❌ '+detail);
  }
}
function editBuyer(id,name,phone){fc('buyer-eid').value=id;fc('buyer-name').value=name;fc('buyer-phone').value=phone;fc('buyer-form-t').textContent='✏️ تعديل مشتري';fc('buyer-cancel-btn').style.display='inline-flex';}
function cancelBuyer(){fc('buyer-eid').value='';fc('buyer-name').value='';fc('buyer-phone').value='';fc('buyer-form-t').textContent='➕ إضافة مشترٍ';fc('buyer-cancel-btn').style.display='none';}
async function delBuyer(id){if(!confirm('حذف هذا المشتري؟'))return;await dbDel('buyers',id);await loadBuyers();renderBuyers();}

// REPORTS
async function loadReports(){
  const month=fc('r-month').value,buyerF=fc('r-buyer').value;
  const cont=fc('reports-cont');
  cont.innerHTML='<div class="card"><div class="empty"><p>⏳ جارٍ التحميل...</p></div></div>';
  try{
    const[y,m]=month.split('-');const last=new Date(y,m,0).getDate();
    const sales=await dbSel('sales','select=*,buyers(name),categories(name)&sale_date=gte.'+month+'-01&sale_date=lte.'+month+'-'+last+'&order=sale_date');
    const mlbl=MON[parseInt(m)-1]+' '+y;
    if(!sales||!sales.length){cont.innerHTML=`<div class="card"><div class="empty"><span class="ei">📭</span><p>لا توجد مبيعات في ${mlbl}</p></div></div>`;return;}
    const grand=sales.reduce((s,x)=>s+x.quantity*x.unit_price,0),grandH=sales.reduce((s,x)=>s+x.quantity,0);
    const bm={};sales.forEach(s=>{const bid=s.buyer_id||'?';if(!bm[bid])bm[bid]={id:bid,name:s.buyers?.name||'—',total:0,heads:0,deals:0,bc:{}};bm[bid].total+=s.quantity*s.unit_price;bm[bid].heads+=s.quantity;bm[bid].deals++;const cn=s.categories?.name||'?';bm[bid].bc[cn]=(bm[bid].bc[cn]||0)+s.quantity;});
    const byB=Object.values(bm).sort((a,b)=>b.total-a.total);
    const cm={};sales.forEach(s=>{const cn=s.categories?.name||'?';if(!cm[cn])cm[cn]={name:cn,total:0,heads:0,deals:0};cm[cn].total+=s.quantity*s.unit_price;cm[cn].heads+=s.quantity;cm[cn].deals++;});
    const byC=Object.values(cm).sort((a,b)=>b.total-a.total);
    let html=`<div class="sg">
      <div class="sc g"><div class="sl">إيرادات ${mlbl}</div><div class="sv sm">${fmtC(grand)}</div></div>
      <div class="sc gr"><div class="sl">الصفقات</div><div class="sv">${sales.length}</div></div>
      <div class="sc br"><div class="sl">الرؤوس</div><div class="sv">${grandH}</div></div>
      <div class="sc bl"><div class="sl">متوسط الرأس</div><div class="sv sm">${grandH?fmtC(Math.round(grand/grandH)):'—'}</div></div></div>`;
    if(buyerF){
      const fb=byB.find(b=>b.id===buyerF);
      if(fb){
        const fs=sales.filter(s=>s.buyer_id===buyerF);
        html+=`<div class="card" style="border-right:3px solid var(--gold);">
          <div class="card-t">👤 ${fb.name} — ${mlbl}</div>
          <div class="sg"><div class="sc g"><div class="sl">إجمالي مشترياته</div><div class="sv sm">${fmtC(fb.total)}</div></div>
          <div class="sc gr"><div class="sl">رؤوس</div><div class="sv">${fb.heads}</div></div></div>
          <div class="card-t" style="margin-top:8px;">الأصناف</div>
          ${Object.entries(fb.bc).map(([c,h])=>`<div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid var(--border);"><span class="badge ba">${c}</span><span style="font-weight:700">${h} رأس</span></div>`).join('')}
          <div class="card-t" style="margin-top:14px;">الصفقات التفصيلية</div>
          <div class="tbl-w"><table><thead><tr><th>التاريخ</th><th>الصنف</th><th>عدد</th><th>سعر</th><th>الإجمالي</th></tr></thead>
          <tbody>${fs.map(s=>`<tr><td>${fmtD(s.sale_date)}</td><td><span class="badge ba">${s.categories?.name||'—'}</span></td><td>${s.quantity} رأس</td><td>${fmtC(s.unit_price)}</td><td style="font-weight:800;color:#7DEBB0">${fmtC(s.quantity*s.unit_price)}</td></tr>`).join('')}</tbody></table></div></div>`;
      }
    } else {
      html+=`<div class="card"><div class="card-t">👥 المشترون — ${mlbl}</div>
        <div class="tbl-w"><table><thead><tr><th>المشتري</th><th>صفقات</th><th>رؤوس</th><th>الإجمالي</th><th>%</th></tr></thead>
        <tbody>${byB.map(b=>`<tr><td style="font-weight:800">${b.name}</td><td>${b.deals}</td><td>${b.heads}</td>
          <td style="font-weight:800;color:#7DEBB0">${fmtC(b.total)}</td>
          <td><div style="display:flex;align-items:center;gap:6px;"><div class="pbar"><div class="pfill" style="width:${Math.round(b.total/grand*100)}%"></div></div><span style="font-size:11px;color:var(--text2)">${Math.round(b.total/grand*100)}%</span></div></td></tr>`).join('')}
        </tbody></table></div></div>`;
    }
    html+=`<div class="card"><div class="card-t">🐑 الأصناف — ${mlbl}</div>
      <div class="tbl-w"><table><thead><tr><th>الصنف</th><th>رؤوس</th><th>إيرادات</th><th>%</th></tr></thead>
      <tbody>${byC.map(c=>`<tr><td><span class="badge ba">${c.name}</span></td><td style="font-weight:700">${c.heads}</td>
        <td style="font-weight:800;color:#7DEBB0">${fmtC(c.total)}</td>
        <td><div style="display:flex;align-items:center;gap:6px;"><div class="pbar"><div class="pfill" style="width:${Math.round(c.total/grand*100)}%"></div></div><span style="font-size:11px;color:var(--text2)">${Math.round(c.total/grand*100)}%</span></div></td></tr>`).join('')}
      </tbody></table></div></div>`;
    cont.innerHTML=html;
  }catch(e){cont.innerHTML=`<div class="card"><div class="empty"><p>❌ ${e.message}</p></div></div>`;}
}
</script>
</body>
</html>
