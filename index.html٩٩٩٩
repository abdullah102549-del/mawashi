</div>

<!-- MAIN -->
<div class="main">

  <!-- Mobile top bar -->
  <div class="mob-top">
    <div class="mt-brand"><span class="mt-ico">🐑</span><div><div class="mt-title">مبيعات محمد طه</div><div class="mt-sub">نظام إدارة المواشي</div></div></div>
    <div class="mt-date" id="mob-date"></div>
  </div>

  <!-- ─ DASHBOARD ─ -->
  <div id="pg-dash" class="page active">
    <div class="ph"><div><div class="ph-title">🏠 الرئيسية</div><div class="ph-sub">نظرة عامة</div></div><button class="btn b-dark b-sm" onclick="loadDash()">🔄</button></div>
    <div class="ca">
      <div class="sg" id="d-stats"></div>
      <div class="card" id="d-recent" style="display:none;"><div class="card-t">🕒 آخر المبيعات</div><div class="tbl-w"><table><thead><tr><th>التاريخ</th><th>المشتري</th><th>الصنف</th><th>العدد</th><th>الإجمالي</th></tr></thead><tbody id="d-tbody"></tbody></table></div></div>
    </div>
  </div>

  <!-- ─ ENTRY ─ -->
  <div id="pg-entry" class="page">
    <div class="ph"><div><div class="ph-title" id="entry-title">➕ إدخال مبيعة</div><div class="ph-sub">سجّل بيانات الصفقة</div></div><button class="btn b-dark b-sm" id="btn-cancel" style="display:none;" onclick="cancelEdit()">✕ إلغاء</button></div>
    <div class="ca">
      <div id="entry-msg"></div>
      <div class="card">
        <div class="fg-grid">
          <div class="fg full"><label class="lbl">📅 التاريخ *</label>
<input type="hidden" id="f-date"/>
<div style="position:relative;">
  <div style="background:var(--bg3);border:1.5px solid var(--border);border-radius:12px;overflow:hidden;">
    <div style="display:flex;align-items:center;">
      <button type="button" onclick="changeDay(-1)" style="background:var(--bg4);border:none;border-left:1px solid var(--border);color:var(--gold);font-size:22px;width:44px;height:52px;cursor:pointer;flex-shrink:0;">›</button>
      <div style="flex:1;text-align:center;padding:8px 6px;">
        <div id="dp-dayname" style="font-size:11px;color:var(--text2);font-weight:700;margin-bottom:2px;letter-spacing:.5px;"></div>
        <div id="dp-full" style="font-size:16px;font-weight:900;color:var(--text);"></div>
      </div>
      <button type="button" onclick="toggleCal(event)" style="background:var(--bg4);border:none;border-right:1px solid var(--border);border-left:1px solid var(--border);color:var(--gold);font-size:20px;width:44px;height:52px;cursor:pointer;flex-shrink:0;">📅</button>
      <button type="button" onclick="changeDay(1)" style="background:var(--bg4);border:none;border-right:1px solid var(--border);color:var(--gold);font-size:22px;width:44px;height:52px;cursor:pointer;flex-shrink:0;">‹</button>
    </div>
  </div>
  <!-- Calendar Popup -->
  <div id="cal-popup" style="display:none;position:absolute;top:58px;right:0;left:0;z-index:200;background:var(--bg2);border:1px solid var(--border);border-radius:14px;box-shadow:0 8px 40px rgba(0,0,0,.6);padding:14px;min-width:280px;">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
      <button type="button" onclick="calNav(1)" style="background:var(--bg4);border:1px solid var(--border);border-radius:8px;color:var(--gold);font-size:18px;width:36px;height:36px;cursor:pointer;">‹</button>
      <div id="cal-header" style="font-size:15px;font-weight:900;color:var(--gold);"></div>
      <button type="button" onclick="calNav(-1)" style="background:var(--bg4);border:1px solid var(--border);border-radius:8px;color:var(--gold);font-size:18px;width:36px;height:36px;cursor:pointer;">›</button>
    </div>
    <div style="display:grid;grid-template-columns:repeat(7,1fr);gap:3px;margin-bottom:6px;">
      <div style="text-align:center;font-size:10.5px;font-weight:800;color:var(--text2);padding:4px 0;">ح</div>
      <div style="text-align:center;font-size:10.5px;font-weight:800;color:var(--text2);padding:4px 0;">ن</div>
      <div style="text-align:center;font-size:10.5px;font-weight:800;color:var(--text2);padding:4px 0;">ث</div>
      <div style="text-align:center;font-size:10.5px;font-weight:800;color:var(--text2);padding:4px 0;">ر</div>
      <div style="text-align:center;font-size:10.5px;font-weight:800;color:var(--text2);padding:4px 0;">خ</div>
      <div style="text-align:center;font-size:10.5px;font-weight:800;color:var(--text2);padding:4px 0;">ج</div>
      <div style="text-align:center;font-size:10.5px;font-weight:800;color:var(--text2);padding:4px 0;">س</div>
    </div>
    <div id="cal-grid" style="display:grid;grid-template-columns:repeat(7,1fr);gap:3px;"></div>
    <div style="display:flex;justify-content:space-between;margin-top:12px;border-top:1px solid var(--border);padding-top:10px;">
      <button type="button" onclick="closeCal()" style="background:var(--bg4);border:1px solid var(--border);border-radius:8px;color:var(--text2);font-size:13px;font-weight:700;padding:7px 16px;cursor:pointer;font-family:'Tajawal',sans-serif;">مسح</button>
      <button type="button" onclick="goToday()" style="background:var(--gold-dim);border:1px solid rgba(212,168,83,.4);border-radius:8px;color:var(--gold);font-size:13px;font-weight:700;padding:7px 16px;cursor:pointer;font-family:'Tajawal',sans-serif;">اليوم</button>
    </div>
  </div>
</div></div>
          <div class="fg"><label class="lbl">👤 المشتري *</label><select id="f-buyer"><option value="">— اختر —</option></select></div>
          <div class="fg full"><label class="lbl">🐑 الصنف *</label><select id="f-cat" onchange="fillPrice()"><option value="">— اختر الصنف —</option></select></div>
          <div class="fg"><label class="lbl">🔢 العدد (رأس) *</label><input type="number" id="f-qty" min="1" value="1" inputmode="numeric" oninput="calcTotal()"/></div>
          <div class="fg"><label class="lbl">💰 سعر الرأس (ريال) *</label><input type="number" id="f-price" min="0" inputmode="decimal" placeholder="ريال" oninput="calcTotal()"/></div>
          <div class="fg full"><label class="lbl">📝 ملاحظات</label><input id="f-notes" placeholder="أي ملاحظات..."/></div>
        </div>
        <div id="total-bar" class="total-bar" style="display:none;"><div class="t-lbl" id="t-det"></div><div class="t-val" id="t-val"></div></div>
        <div class="b-row"><button class="btn b-gold" style="flex:1;" onclick="saveSale()" id="btn-save">✅ حفظ المبيعة</button><button class="btn b-dark" onclick="clearForm()" id="btn-clr">🔄</button></div>
      </div>
    </div>
