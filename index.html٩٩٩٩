<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>مبيعات محمد طه</title>
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#0F0F13;
  --bg2:#18181F;
  --bg3:#22222C;
  --bg4:#2A2A36;
  --gold:#D4A853;
  --gold2:#E8C070;
  --gold-dim:rgba(212,168,83,.12);
  --text:#F0EAE0;
  --text2:#A09080;
  --text3:#6A5E54;
  --border:#2E2E3A;
  --green:#4CAF7A;
  --red:#E05555;
  --blue:#5B9BD5;
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
html{height:100%;}
body{font-family:'Tajawal',sans-serif;background:var(--bg);color:var(--text);direction:rtl;min-height:100vh;overflow-x:hidden;}

/* ───── SETUP ───── */
.setup-wrap{min-height:100vh;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#0F0F13 0%,#1A1520 100%);padding:16px;}
.setup-card{background:var(--bg2);border:1px solid var(--border);border-radius:20px;padding:28px 22px;max-width:520px;width:100%;box-shadow:0 20px 60px rgba(0,0,0,.5);}
.s-head{text-align:center;margin-bottom:24px;}
.s-head .ico{font-size:44px;display:block;margin-bottom:8px;}
.s-head h1{color:var(--gold);font-size:22px;font-weight:900;}
.s-head p{color:var(--text2);font-size:13px;margin-top:4px;}
.s-step{font-size:12.5px;font-weight:800;color:var(--gold);margin:16px 0 6px;}
.s-info{background:rgba(212,168,83,.07);border:1px solid rgba(212,168,83,.2);border-radius:8px;padding:11px 13px;font-size:12px;color:var(--text2);line-height:1.85;}
.s-info strong{color:var(--gold);}
.sql-box{background:#0A0A0F;border:1px solid var(--border);border-radius:8px;padding:12px;margin:8px 0;overflow:auto;max-height:180px;}
.sql-box code{color:#7EC8A0;font-family:'Courier New',monospace;font-size:10.5px;white-space:pre;direction:ltr;text-align:left;display:block;line-height:1.7;}
.s-row{display:flex;gap:8px;margin-bottom:8px;}

/* ───── INPUTS ───── */
.fg{display:flex;flex-direction:column;gap:5px;margin-bottom:12px;}
.lbl{font-size:12px;font-weight:700;color:var(--text2);}
input,select,textarea{
  border:1.5px solid var(--border);border-radius:9px;
  padding:11px 13px;font-family:'Tajawal',sans-serif;font-size:14px;
  color:var(--text);background:var(--bg3);outline:none;width:100%;
  transition:border-color .2s,box-shadow .2s;-webkit-appearance:none;
  caret-color:var(--gold);
}
input:focus,select:focus,textarea:focus{border-color:var(--gold);box-shadow:0 0 0 3px rgba(212,168,83,.1);}
select option{background:var(--bg3);color:var(--text);}
textarea{resize:vertical;min-height:70px;}
input::placeholder{color:var(--text3);}

/* ───── BUTTONS ───── */
.btn{
  padding:11px 18px;border-radius:10px;border:none;
  font-family:'Tajawal',sans-serif;font-size:14px;font-weight:700;
  cursor:pointer;transition:all .15s;display:inline-flex;align-items:center;justify-content:center;gap:5px;
}
.btn:active{transform:scale(.96);}
.btn:disabled{opacity:.5;cursor:not-allowed;}
.b-gold{background:var(--gold);color:#0F0F13;}
.b-gold:hover:not(:disabled){background:var(--gold2);}
.b-dark{background:var(--bg4);color:var(--text);border:1px solid var(--border);}
.b-dark:hover:not(:disabled){background:var(--bg3);}
.b-red{background:#3A1515;color:#E88080;border:1px solid #5A2020;}
.b-red:hover:not(:disabled){background:#451A1A;}
.b-outline{background:transparent;color:var(--gold);border:1.5px solid rgba(212,168,83,.4);}
.b-outline:hover:not(:disabled){background:var(--gold-dim);}
.b-sm{padding:6px 11px;font-size:12px;border-radius:7px;}
.b-full{width:100%;}
.b-row{display:flex;gap:8px;margin-top:14px;flex-wrap:wrap;}

/* ───── CARDS ───── */
.card{background:var(--bg2);border:1px solid var(--border);border-radius:14px;padding:16px;margin-bottom:12px;}
.card-t{font-size:14px;font-weight:800;color:var(--text);margin-bottom:12px;padding-bottom:10px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:6px;}

/* ───── STAT GRID ───── */
.sg{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px;}
.sg.cols3{grid-template-columns:1fr 1fr 1fr;}
.sc{background:var(--bg2);border:1px solid var(--border);border-radius:12px;padding:14px 13px;}
.sc.g{border-top:2px solid var(--gold);}
.sc.gr{border-top:2px solid var(--green);}
.sc.br{border-top:2px solid #A0724A;}
.sc.bl{border-top:2px solid var(--blue);}
.sl{font-size:10.5px;color:var(--text2);font-weight:700;margin-bottom:5px;text-transform:uppercase;letter-spacing:.3px;}
.sv{font-size:22px;font-weight:900;color:var(--text);line-height:1;}
.sv.sm{font-size:15px;line-height:1.3;}
.ss{font-size:10px;color:var(--text3);margin-top:3px;}

/* ───── TABLE ───── */
.tbl-w{overflow-x:auto;-webkit-overflow-scrolling:touch;}
table{width:100%;border-collapse:collapse;}
th{background:var(--bg3);padding:9px 11px;text-align:right;font-size:11px;font-weight:800;color:var(--text2);white-space:nowrap;border-bottom:1px solid var(--border);}
td{padding:10px 11px;font-size:12.5px;border-bottom:1px solid var(--border);vertical-align:middle;color:var(--text);}
tr:last-child td{border-bottom:none;}
tr:hover td{background:rgba(255,255,255,.02);}
.badge{display:inline-flex;align-items:center;padding:3px 9px;border-radius:20px;font-size:11px;font-weight:700;}
.ba{background:rgba(212,168,83,.15);color:var(--gold);}
.alert{padding:11px 14px;border-radius:9px;font-size:13px;margin-bottom:12px;font-weight:600;}
.a-ok{background:rgba(76,175,122,.12);color:#7DEBB0;border:1px solid rgba(76,175,122,.25);}
.a-er{background:rgba(224,85,85,.12);color:#F09090;border:1px solid rgba(224,85,85,.25);}
.empty{text-align:center;padding:36px 16px;color:var(--text3);}
.empty .ei{font-size:38px;margin-bottom:8px;display:block;}

/* ───── TOTAL BAR ───── */
.total-bar{background:rgba(76,175,122,.08);border:1px solid rgba(76,175,122,.2);border-radius:10px;padding:12px 14px;margin-top:12px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:6px;}
.t-lbl{font-size:12.5px;color:var(--green);font-weight:700;}
.t-val{font-size:20px;font-weight:900;color:#7DEBB0;}
.pbar{flex:1;background:var(--bg4);border-radius:4px;height:5px;overflow:hidden;min-width:50px;}
.pfill{height:5px;background:linear-gradient(90deg,var(--gold),var(--gold2));border-radius:4px;}

/* ───── LAYOUT ───── */
.layout{display:flex;min-height:100vh;}
.sidebar{
  width:230px;min-width:230px;
  background:var(--bg2);border-left:1px solid var(--border);
  position:fixed;top:0;right:0;bottom:0;z-index:50;
  display:flex;flex-direction:column;overflow-y:auto;
}
.main{margin-right:230px;flex:1;display:flex;flex-direction:column;}
.sb-logo{padding:20px 16px 14px;border-bottom:1px solid var(--border);text-align:center;}
.sb-logo .ico{font-size:32px;display:block;margin-bottom:5px;}
.sb-logo h1{color:var(--gold);font-size:15px;font-weight:900;line-height:1.4;}
.sb-logo small{color:var(--text3);font-size:10px;}
.sb-date{padding:10px 14px;background:var(--gold-dim);border-bottom:1px solid var(--border);text-align:center;}
.sb-date .dn{color:var(--gold);font-size:13px;font-weight:700;}
.sb-date .df{color:var(--text2);font-size:11px;margin-top:2px;}
.sb-nav{flex:1;padding:8px 0;}
.nav-item{display:flex;align-items:center;gap:10px;padding:12px 17px;color:var(--text3);cursor:pointer;transition:all .15s;border-right:3px solid transparent;font-size:13.5px;font-weight:500;}
.nav-item:hover{color:var(--text);background:rgba(255,255,255,.03);}
.nav-item.active{color:var(--gold);background:var(--gold-dim);border-right-color:var(--gold);font-weight:700;}
.nav-item .ni{font-size:16px;width:20px;text-align:center;}
.sb-foot{padding:12px 14px;border-top:1px solid var(--border);}

/* ───── PAGE HEADER ───── */
.ph{background:var(--bg2);border-bottom:1px solid var(--border);padding:13px 18px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:10;}
.ph-title{font-size:16px;font-weight:900;color:var(--text);}
.ph-sub{font-size:11px;color:var(--text2);margin-top:1px;}
.ca{padding:14px 16px;flex:1;}
.page{display:none;flex-direction:column;flex:1;}
.page.active{display:flex;}
.two-col{display:grid;grid-template-columns:1fr 1.8fr;gap:12px;}
.fg-grid{display:grid;grid-template-columns:1fr 1fr;gap:0 12px;}
.fg-grid .full{grid-column:1/-1;}
.flex-row{display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end;margin-bottom:12px;}

/* ───── MOBILE ───── */
@media(max-width:768px){
  .sidebar{display:none;}
  .main{margin-right:0;padding-bottom:76px;}
  .two-col{grid-template-columns:1fr;}
  .fg-grid{grid-template-columns:1fr;}
  .sg.cols3{grid-template-columns:1fr 1fr;}

  .mob-top{
    display:flex;
    background:var(--bg2);border-bottom:1px solid var(--border);
    padding:12px 16px;align-items:center;justify-content:space-between;
    position:sticky;top:0;z-index:20;
  }
  .mob-top .mt-brand{display:flex;align-items:center;gap:8px;}
  .mob-top .mt-ico{font-size:22px;}
  .mob-top .mt-title{color:var(--gold);font-size:15px;font-weight:900;line-height:1.2;}
  .mob-top .mt-sub{color:var(--text3);font-size:10px;}
  .mob-top .mt-date{color:var(--text2);font-size:11px;text-align:left;}

  .bottom-nav{
    display:flex;
    position:fixed;bottom:0;left:0;right:0;z-index:100;
    background:var(--bg2);border-top:1px solid var(--border);
    height:70px;
    box-shadow:0 -8px 30px rgba(0,0,0,.4);
  }
  .bn-item{
    flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;
    gap:3px;cursor:pointer;padding:6px 4px;
    color:var(--text3);font-size:10px;font-weight:600;
    transition:all .15s;border-top:2px solid transparent;
    position:relative;
  }
  .bn-item.active{color:var(--gold);border-top-color:var(--gold);}
  .bn-item .bni{font-size:21px;line-height:1;}
  .bn-more-sheet{
    position:fixed;bottom:70px;left:0;right:0;
    background:var(--bg2);border-top:1px solid var(--border);
    z-index:99;padding:6px 0;
    box-shadow:0 -8px 30px rgba(0,0,0,.4);
  }

  .ph{padding:10px 14px;}
  .ph-title{font-size:15px;}
  .ca{padding:12px 13px;}
  .card{padding:14px;}
  th,td{padding:8px 10px;}
}
@media(min-width:769px){
  .mob-top{display:none;}
  .bottom-nav{display:none;}
  .bn-more-sheet{display:none!important;}
}
</style>
</head>
<body>

<!-- ══ SETUP ══ -->
<div id="setup-screen" style="display:none;">
<div class="setup-wrap">
<div class="setup-card">
  <div class="s-head"><span class="ico">🐑</span><h1>مبيعات محمد طه</h1><p>إعداد قاعدة البيانات — مرة واحدة</p></div>
  <div class="s-step">📦 الخطوة الأولى — Supabase</div>
  <div class="s-info">١. روح <strong>supabase.com</strong> → حساب مجاني → New Project<br>٢. بعد الإنشاء → <strong>SQL Editor</strong> → الصق الكود أدناه → <strong>RUN</strong></div>
  <div class="s-row">
    <button class="btn b-dark b-sm" onclick="toggleSQL()">▼ الكود</button>
    <button class="btn b-gold b-sm" onclick="copySQL()">📋 نسخ كود SQL</button>
  </div>
  <div id="sql-box" class="sql-box" style="display:none;"><code id="sql-code"></code></div>
  <div class="s-step">🔑 الخطوة الثانية — بيانات الاتصال</div>
  <div class="s-info">Settings → API → انسخ <strong>Project URL</strong> و <strong>anon public key</strong></div>
  <div id="setup-msg"></div>
  <div class="fg" style="margin-top:12px;"><label class="lbl">Project URL</label><input id="inp-url" placeholder="https://xxxxxxxxxx.supabase.co" style="direction:ltr;text-align:left;"/></div>
  <div class="fg"><label class="lbl">Anon Key</label><input id="inp-key" placeholder="eyJhbGci..." style="direction:ltr;text-align:left;"/></div>
  <button class="btn b-gold b-full" style="padding:13px;margin-top:14px;" onclick="doConnect()">🔗 ربط والبدء</button>
  <p style="margin-top:10px;font-size:11px;color:var(--text3);text-align:center;">🔒 بياناتك محفوظة في متصفحك فقط</p>
</div>
</div>
</div>

<!-- ══ APP ══ -->
<div id="app" style="display:none;">
<div class="layout">

<!-- SIDEBAR (desktop) -->
<div class="sidebar">
  <div class="sb-logo"><span class="ico">🐑</span><h1>مبيعات<br>محمد طه</h1><small>نظام إدارة المواشي</small></div>
  <div class="sb-date"><div class="dn" id="sb-day"></div><div class="df" id="sb-date"></div></div>
  <div class="sb-nav">
    <div class="nav-item active" data-p="dash" onclick="go('dash')"><span class="ni">🏠</span>الرئيسية</div>
    <div class="nav-item" data-p="entry" onclick="go('entry')"><span class="ni">➕</span>إدخال مبيعات</div>
    <div class="nav-item" data-p="list" onclick="go('list')"><span class="ni">📋</span>سجل المبيعات</div>
    <div class="nav-item" data-p="cats" onclick="go('cats')"><span class="ni">🐑</span>الأصناف والأسعار</div>
    <div class="nav-item" data-p="buyers" onclick="go('buyers')"><span class="ni">👥</span>المشترين</div>
    <div class="nav-item" data-p="reports" onclick="go('reports')"><span class="ni">📊</span>التقارير</div>
  </div>
